# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# CHAPA_SECRET_KEY: Secret API key from https://dashboard.chapa.co for Ethiopian Birr transactions
CHAPA_SECRET_KEY=

# VITE_CHAPA_PUBLIC_KEY: Public key for Chapa integration
VITE_CHAPA_PUBLIC_KEY=

# TELEBIRR DEVELOPER API CONFIGURATION (Ethio Telecom)
# Assigned App ID from Ethio Telecom developer portal
TELEBIRR_APP_ID=
# Merchant App Key / Secret
TELEBIRR_APP_KEY=
# Merchant Short Code / Till Number
TELEBIRR_SHORT_CODE=
# Telebirr RSA Public Key (PEM format or one-line base64) for payload encryption
TELEBIRR_PUBLIC_KEY=
# Merchant RSA Private Key (PEM format) for signing requests
TELEBIRR_PRIVATE_KEY=
# Optional custom API endpoint (defaults to https://app.ethiotelecom.et/epg/v1/to/pay)
TELEBIRR_API_URL=
# ADMIN NOTIFICATION CONFIGURATION
# Default recipient for student payment and teacher registration alerts
ADMIN_NOTIFICATION_EMAIL="melkamukebede11@gmail.com"
# Optional transactional email provider keys for production delivery (Resend / SendGrid)
RESEND_API_KEY=
SENDGRID_API_KEY=
