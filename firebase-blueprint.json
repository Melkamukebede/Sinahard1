{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 256 },
        "displayName": { "type": "string", "maxLength": 128 },
        "photoURL": { "type": "string", "maxLength": 512 },
        "grade": { "type": "string", "maxLength": 32 },
        "stream": { "type": "string", "maxLength": 64 },
        "schoolName": { "type": "string", "maxLength": 128 },
        "region": { "type": "string", "maxLength": 64 },
        "targetExamYear": { "type": "string", "maxLength": 32 },
        "phoneNumber": { "type": "string", "maxLength": 32 },
        "isRegistered": { "type": "boolean" },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "email"]
    },
    "Exam": {
      "title": "Exam",
      "description": "Exam data containing questions and settings",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 256 },
        "title": { "type": "string", "maxLength": 256 },
        "subject": { "type": "string", "maxLength": 128 },
        "difficulty": { "type": "string", "enum": ["Easy", "Medium", "Hard"] },
        "timeLimit": { "type": "number" },
        "passingScore": { "type": "number" },
        "subjectType": { "type": "string", "enum": ["theory", "calculation"] },
        "description": { "type": "string", "maxLength": 1000 },
        "questions": { "type": "array" },
        "userId": { "type": "string", "maxLength": 128 },
        "isPublic": { "type": "boolean" },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "name", "userId", "questions"]
    },
    "Result": {
      "title": "Result",
      "description": "Exam test attempt outcome and question review",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "examId": { "type": "string", "maxLength": 128 },
        "examTitle": { "type": "string", "maxLength": 256 },
        "userId": { "type": "string", "maxLength": 128 },
        "date": { "type": "string", "maxLength": 64 },
        "score": { "type": "number" },
        "total": { "type": "number" },
        "percentage": { "type": "number" },
        "passingScore": { "type": "number" },
        "timeSpent": { "type": "number" },
        "answers": { "type": "array" },
        "subjectType": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "examId", "userId", "score", "total", "percentage"]
    },
    "StudyReminder": {
      "title": "StudyReminder",
      "description": "User notification reminder preferences",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "time": { "type": "string", "maxLength": 16 },
        "enabled": { "type": "boolean" },
        "days": { "type": "array" }
      },
      "required": ["id", "userId", "enabled"]
    },
    "Subscription": {
      "title": "Subscription",
      "description": "Student premium subscription record for Ethiopian Birr payments (Chapa, Telebirr, CBE)",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "userEmail": { "type": "string", "maxLength": 256 },
        "userName": { "type": "string", "maxLength": 128 },
        "planDuration": { "type": "string", "enum": ["1day", "1week", "1month", "6months"] },
        "amountETB": { "type": "number" },
        "paymentMethod": { "type": "string", "enum": ["chapa", "telebirr", "cbe", "abyssinia"] },
        "transactionReference": { "type": "string", "maxLength": 128 },
        "paymentStatus": { "type": "string", "enum": ["pending", "verified", "rejected", "expired"] },
        "startDate": { "type": "string", "maxLength": 64 },
        "expiresAt": { "type": "string", "maxLength": 64 },
        "createdAt": { "type": "string", "maxLength": 64 },
        "verifiedAt": { "type": "string", "maxLength": 64 },
        "verifiedBy": { "type": "string", "maxLength": 128 },
        "notes": { "type": "string", "maxLength": 500 }
      },
      "required": ["id", "userId", "planDuration", "amountETB", "paymentMethod", "transactionReference", "paymentStatus", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Profile information of registered users"
    },
    "/exams/{examId}": {
      "schema": "Exam",
      "description": "Exam documents created by users or templates"
    },
    "/results/{resultId}": {
      "schema": "Result",
      "description": "Exam completion records and question answer histories"
    },
    "/reminders/{reminderId}": {
      "schema": "StudyReminder",
      "description": "Study notification alerts and schedules"
    },
    "/subscriptions/{subscriptionId}": {
      "schema": "Subscription",
      "description": "Premium student subscription and payment transaction logs"
    }
  }
}
